#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

APP_ROOT='/usr/share/mihomo-globe/www'

resolve_listen_address() {
    local configured="$1"

    if [ "$configured" != 'lan' ]; then
        printf '%s' "$configured"
        return
    fi

    ubus call network.interface.lan status 2>/dev/null \
        | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null \
        || printf '0.0.0.0'
}

start_service() {
    local enabled listen port

    config_load mihomo-globe
    config_get_bool enabled main enabled 1
    [ "$enabled" -eq 1 ] || return 0
    config_get listen main listen 'lan'
    config_get port main port '9091'
    listen="$(resolve_listen_address "$listen")"

    procd_open_instance
    procd_set_param command /usr/sbin/uhttpd
    procd_append_param command -f -h "$APP_ROOT" -x /cgi-bin -p "$listen:$port"
    procd_append_param command -t 30 -T 30 -k 20 -A 1
    procd_set_param respawn 3600 5 5
    procd_set_param file /etc/config/mihomo-globe /etc/nikki/run/config.yaml
    procd_set_param limits core='0'
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger mihomo-globe
    procd_add_interface_trigger 'interface.*.up' lan /etc/init.d/mihomo-globe restart
}
