#!/bin/sh

set -eu

fail() {
    printf 'mihomo-globe-update: %s\n' "$1" >&2
    exit 1
}

for command_name in curl yq sha256sum uci; do
    command -v "$command_name" >/dev/null 2>&1 || fail "required command is missing: $command_name"
done

explicit_url="${1:-}"
configured_url="$(uci -q get mihomo-globe.main.archive_url || true)"

if [ -n "$explicit_url" ] || [ -n "$configured_url" ]; then
    exec /usr/share/mihomo-globe/install.sh "${explicit_url:-$configured_url}"
fi

repository="$(uci -q get mihomo-globe.main.github_repository || true)"
token_file="$(uci -q get mihomo-globe.main.github_token_file || true)"
[ -n "$token_file" ] || token_file='/etc/mihomo-globe/github-token'

[ -n "$repository" ] || fail 'no archive URL or private GitHub repository is configured'
[ -r "$token_file" ] || fail "GitHub credential is missing: $token_file"

case "$repository" in
    */*) ;;
    *) fail 'GitHub repository must use OWNER/REPOSITORY format' ;;
esac

umask 077
work_dir="$(mktemp -d /tmp/mihomo-globe-github.XXXXXX)"
curl_config="$work_dir/curl.conf"
archive="$work_dir/mihomo-globe.tar.gz"
checksum="$work_dir/mihomo-globe.tar.gz.sha256"

cleanup() {
    rm -rf "$work_dir"
}
trap cleanup EXIT INT TERM

IFS= read -r token < "$token_file" || true
[ -n "$token" ] || fail 'GitHub credential file is empty'

# A temporary curl config keeps the bearer token out of process arguments and logs.
printf 'header = "Authorization: Bearer %s"\n' "$token" > "$curl_config"
printf '%s\n' 'header = "X-GitHub-Api-Version: 2022-11-28"' >> "$curl_config"
printf '%s\n' 'user-agent = "Mihomo-Globe-Updater/0.1"' >> "$curl_config"
unset token

github_api="https://api.github.com/repos/$repository"
release_json="$(curl --config "$curl_config" --fail --location --silent --show-error \
    --header 'Accept: application/vnd.github+json' "$github_api/releases/latest")" \
    || fail 'could not read the latest private GitHub release'

asset_id() {
    asset_name="$1"
    printf '%s' "$release_json" \
        | yq -p json -r ".assets[] | select(.name == \"$asset_name\") | .id" 2>/dev/null \
        | sed -n '1p'
}

archive_id="$(asset_id 'mihomo-globe.tar.gz')"
checksum_id="$(asset_id 'mihomo-globe.tar.gz.sha256')"
release_tag="$(printf '%s' "$release_json" | yq -p json -r '.tag_name // "latest"' 2>/dev/null)"

[ -n "$archive_id" ] && [ "$archive_id" != 'null' ] || fail 'latest release has no globe archive'
[ -n "$checksum_id" ] && [ "$checksum_id" != 'null' ] || fail 'latest release has no checksum'

curl --config "$curl_config" --fail --location --silent --show-error \
    --header 'Accept: application/octet-stream' --output "$archive" \
    "$github_api/releases/assets/$archive_id" \
    || fail 'could not download the private globe archive'
curl --config "$curl_config" --fail --location --silent --show-error \
    --header 'Accept: application/octet-stream' --output "$checksum" \
    "$github_api/releases/assets/$checksum_id" \
    || fail 'could not download the private globe checksum'

(cd "$work_dir" && sha256sum -c mihomo-globe.tar.gz.sha256) \
    || fail 'private release checksum verification failed'

printf 'Installing Mihomo Globe %s…\n' "$release_tag"
/usr/share/mihomo-globe/install.sh "$archive"
